# Plantilla de referencia. Spring Boot no carga este archivo automáticamente.
# Exportar valores propios en la terminal; no ejecutar esta plantilla con source.
# Para Compose: python3 scripts/init-local-env.py genera .env sin sobrescribirlo.
# La contraseña se conserva fuera de Git y no debe mostrarse ni compartirse.
POSTGRES_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_BASE_URL=http://127.0.0.1:5173
# Valores de la demostración aprobada. Exportarlos explícitamente al iniciar el backend.
APP_TIME_ZONE=America/Argentina/Mendoza
APP_CONSULTORIO_NOMBRE=Grupo13
APP_ODONTOLOGO_NOMBRE="Carlos Garcia"
# Ruta del archivo privado que genera credencial-odontologo. Se configura fuera de Git.
APP_DENTIST_CREDENTIAL_FILE=
# Completar localmente con una base de prueba habilitada; no hay valores por defecto.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
